# /etc/ai-proxy/env
# サービス定義(supervise-daemon / systemd の EnvironmentFile)から読まれる。0600 で置くこと。
# ここに書いた値は /etc/ai-proxy/config.toml より優先される。

# 上流のキー。これが無いと serve は起動しない。
AI_PROXY_UPSTREAM_API_KEY=replace-me

# 上流のベース URL(既定は command-code)
# AI_PROXY_UPSTREAM_BASE_URL=https://api.commandcode.ai/provider/v1

# 許可モデル(カンマ区切り)。設定すると models を丸ごと置き換える。
# AI_PROXY_MODELS=deepseek/deepseek-v4.1-flash

# 待ち受け。Tailscale の IP に絞るなら 100.x.y.z:8787
# AI_PROXY_LISTEN=0.0.0.0:8787

# 保存期間・本文保存
# AI_PROXY_RETENTION_DAYS=30
# AI_PROXY_CAPTURE_TTL_HOURS=24
# AI_PROXY_CAPTURE_MAX_BYTES=65536

# キー発行の対話モードで Enter したときの推奨月次上限。0 で「上限なし」を推奨
# AI_PROXY_DEFAULT_MONTHLY_CAP=60000000

# ログ
# RUST_LOG=info
