[Unit]
Description=ai-proxy (OpenAI-compatible proxy that records token usage)
Documentation=file:///usr/share/doc/ai-proxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-proxy
Group=ai-proxy

# 設定はすべて環境変数から。上流キーはこのファイルに書く。
EnvironmentFile=/etc/ai-proxy/env

StateDirectory=ai-proxy
Environment=AI_PROXY_DB_PATH=/var/lib/ai-proxy/usage.db
Environment=AI_PROXY_LISTEN=0.0.0.0:8787
Environment=RUST_LOG=info

ExecStart=/usr/local/bin/ai-proxy serve
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
